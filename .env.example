# App
PORT=3000
NODE_ENV=development

# Database
# Local Docker Compose usa internamente:
# postgresql://ticket:ticket@postgres:5432/ticket_system
#
# Para rodar apontando para Supabase, copie este arquivo para `.env` e preencha:
# DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# Docker entrypoint
RUN_MIGRATIONS=true

# Redis entra nas proximas etapas; no Docker local futuro, use redis://redis:6379.
REDIS_URL=redis://localhost:6379

# Waiting room/playground legado
QUEUE_CAPACITY=3
SESSION_TTL_MS=60000
ADMIT_INTERVAL_MS=1000
