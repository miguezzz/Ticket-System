# Copie para `.env` na raiz do projeto e preencha com a connection string do Supabase.
#
# Use a connection string Postgres do projeto Supabase com SSL habilitado.
# Exemplo:
# DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# Redis entra nas proximas etapas. Pode ficar assim por enquanto.
REDIS_URL=redis://redis:6379

# O entrypoint do backend roda migrations automaticamente quando true.
RUN_MIGRATIONS=true
